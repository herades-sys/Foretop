<UserControl x:Class="Broadside.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Broadside.App.Charts">
    <UserControl.Resources>
        <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKey"
                         ToolTip="Player name (at least 3 characters for suggestions)" />
                <Button Content="Show profile" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" Margin="6,0,0,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" ToolTip="Fetch fresh statistics, ignoring the cache" />
                <TextBlock Text="Loading…" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
            </StackPanel>
            <Popup IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                        Width="300" Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="10,5"
                                        Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource NoticeBg}" BorderBrush="{StaticResource RateYellow}" BorderThickness="1" CornerRadius="4" Padding="12,8"
                        Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>

                <!-- Empty state -->
                <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left"
                        Visibility="{Binding HasPlayer, Converter={StaticResource InvBoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Player profiles" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0">
                            Search for any player on the selected server, or double-click a player in Live Battle. The profile shows overall
                            and per-ship statistics, the best and most played ships, recent activity, win-rate history and the recorded
                            battles you shared with them.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasPlayer, Converter={StaticResource BoolVis}}">
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Official profile" Command="{Binding OpenOfficialCommand}" Margin="0,0,6,0" />
                            <Button Content="wows-numbers" Command="{Binding OpenNumbersCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ClanTag}" Style="{StaticResource H1}" Foreground="{StaticResource TextDim}" Margin="0,0,8,0"
                                           Visibility="{Binding ClanTag, Converter={StaticResource NullVis}}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="OVERALL — RANDOM BATTLES" Style="{StaticResource Dim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource StatCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="210" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Dim}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding RecentCards}" ItemTemplate="{StaticResource StatCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="320" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Charts -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Most played ships" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <charts:BarChart Items="{Binding MostPlayed}" LabelWidth="160" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Best performing ships (PR, 20+ battles)" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <charts:BarChart Items="{Binding BestShips}" LabelWidth="160" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Battles by class" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <charts:BarChart Items="{Binding ClassBreakdown}" LabelWidth="130" />
                                <TextBlock Text="Battles by tier" Style="{StaticResource H2}" Margin="0,14,0,8" />
                                <charts:BarChart Items="{Binding TierBreakdown}" LabelWidth="130" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Win-rate progression" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <charts:LineChart Series="{Binding WinRateHistory}" Height="180" Format="0.0'%'"
                                                  EmptyText="No history yet — it fills in each time Broadside sees this player." />
                                <TextBlock Text="{Binding WinRateHistoryNote}" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Ships -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                        <StackPanel>
                            <TextBlock Text="All ships (Random battles)" Style="{StaticResource H2}" Margin="14,12,14,8" />
                            <DataGrid ItemsSource="{Binding Ships}" MaxHeight="520" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="SHIP" Width="*" MinWidth="200" SortMemberPath="ShipName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="34" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="{Binding ClassShort}" Foreground="{Binding ShipClass, Converter={StaticResource ClassBrush}}"
                                                               FontWeight="SemiBold" FontSize="11" Width="22" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ShipName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="TIER" Binding="{Binding TierText}" SortMemberPath="Tier" Width="50" />
                                    <DataGridTemplateColumn Header="BATTLES" SortMemberPath="Battles" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Battles, StringFormat=N0}" Style="{StaticResource Num}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="WIN RATE" SortMemberPath="WinRate" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding WinRateText}" Style="{StaticResource Num}"
                                                                     Foreground="{Binding WinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="AVG DAMAGE" SortMemberPath="AvgDamage" Width="96">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding AvgDamageText}" Style="{StaticResource Num}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="AVG XP" SortMemberPath="AvgXp" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding AvgXpText}" Style="{StaticResource Num}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="FRAGS" SortMemberPath="AvgFrags" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding AvgFragsText}" Style="{StaticResource Num}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PR" SortMemberPath="Pr" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding PrText}" Style="{StaticResource Num}" FontWeight="SemiBold"
                                                                     Foreground="{Binding PrRated, Converter={StaticResource Rating}, ConverterParameter=pr}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="LAST BATTLE" SortMemberPath="LastBattle" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding LastBattleText}" Style="{StaticResource Num}" Foreground="{StaticResource TextDim}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Encounters -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,8" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Recorded battles with this player" Style="{StaticResource H2}" Margin="14,12,14,4" />
                            <TextBlock Text="None yet. Battles Broadside detects or opens are listed here." Style="{StaticResource Dim}" Margin="14,0,14,12"
                                       Visibility="{Binding HasEncounters, Converter={StaticResource InvBoolVis}}" />
                            <DataGrid ItemsSource="{Binding Encounters}" MaxHeight="300" MouseDoubleClick="OnEncounterDoubleClick"
                                      Visibility="{Binding HasEncounters, Converter={StaticResource BoolVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding When, StringFormat=g}" SortMemberPath="When" Width="140" />
                                    <DataGridTextColumn Header="BATTLE" Binding="{Binding Battle}" Width="*" />
                                    <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="110" />
                                    <DataGridTextColumn Header="SHIP" Binding="{Binding Ship}" Width="150" />
                                    <DataGridTextColumn Header="THEIR STATS THEN" Binding="{Binding StatsAtTheTime}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
