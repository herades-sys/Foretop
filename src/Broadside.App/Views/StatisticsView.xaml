<UserControl x:Class="Broadside.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Broadside.App.Charts">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14,16,10">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadCommand}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Statistics" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Across the battles Broadside has recorded. Results are not in the file the game writes, so this covers who you met, not whether you won." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left"
                    Visibility="{Binding HasData, Converter={StaticResource InvBoolVis}}">
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                           Text="No battles recorded yet. Play a battle with Broadside running, or open a replay, and statistics appear here." />
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource StatCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="230" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.ColumnSpan="3">
                        <StackPanel>
                            <TextBlock Text="Team strength per battle (average PR)" Style="{StaticResource H2}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Width="10" Height="3" Fill="{StaticResource Friendly}" VerticalAlignment="Center" />
                                <TextBlock Text="your team" Style="{StaticResource Dim}" FontSize="11" Margin="4,0,14,0" />
                                <Rectangle Width="10" Height="3" Fill="{StaticResource Enemy}" VerticalAlignment="Center" />
                                <TextBlock Text="enemy team" Style="{StaticResource Dim}" FontSize="11" Margin="4,0,0,0" />
                            </StackPanel>
                            <charts:LineChart Series="{Binding StrengthTrend}" Height="190" Format="0"
                                              EmptyText="Needs at least two recorded battles with PR data." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Your ships" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <charts:BarChart Items="{Binding OwnShips}" LabelWidth="150" />
                            <TextBlock Text="Battle types" Style="{StaticResource H2}" Margin="0,14,0,8" />
                            <charts:BarChart Items="{Binding ByType}" LabelWidth="150" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Maps" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <charts:BarChart Items="{Binding ByMap}" LabelWidth="150" />
                            <TextBlock Text="Enemy ship classes" Style="{StaticResource H2}" Margin="0,14,0,8" />
                            <charts:BarChart Items="{Binding EnemyClasses}" LabelWidth="150" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Battles per day (last 14 active days)" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <charts:BarChart Items="{Binding ByDay}" LabelWidth="110" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Players you met most often" Style="{StaticResource H2}" Margin="14,12,14,8" />
                            <TextBlock Text="Nobody seen twice yet." Margin="14,0,14,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopPlayers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding TopPlayers}" MaxHeight="340" MouseDoubleClick="OnPlayerDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PLAYER" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="MET" Binding="{Binding Times}" Width="50" />
                                    <DataGridTextColumn Header="WITH" Binding="{Binding With}" Width="50" />
                                    <DataGridTextColumn Header="AGAINST" Binding="{Binding Against}" Width="66" />
                                    <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeen, StringFormat=d}" Width="86" />
                                    <DataGridTextColumn Header="THEN" Binding="{Binding LastStats}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
