<UserControl x:Class="Broadside.App.Views.TeamTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
        </Storyboard>
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Open profile" Click="OnOpenProfile" FontWeight="SemiBold" />
            <MenuItem Header="Open official profile" Click="OnOpenOfficial" />
            <MenuItem Header="Open on wows-numbers.com" Click="OnOpenNumbers" />
            <Separator />
            <MenuItem Header="Copy player name" Click="OnCopyName" />
        </ContextMenu>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <!-- Team header -->
            <Border DockPanel.Dock="Top" BorderBrush="{Binding Accent, ElementName=Root}" BorderThickness="0,3,0,0" CornerRadius="6,6,0,0"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Header, ElementName=Root}" Style="{StaticResource H2}"
                               Foreground="{Binding Accent, ElementName=Root}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Dim}" FontSize="11.5" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows, ElementName=Root}" MouseDoubleClick="OnRowDoubleClick"
                      ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Player -->
                    <DataGridTemplateColumn Header="PLAYER" Width="*" MinWidth="120" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ClanTag}" Style="{StaticResource Dim}" Margin="0,0,4,0"
                                               Visibility="{Binding ClanTag, Converter={StaticResource NullVis}}" />
                                    <TextBlock x:Name="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="state" Text="{Binding StateText}" Style="{StaticResource Dim}" FontSize="11"
                                               FontStyle="Italic" Margin="6,0,0,0" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="pulse" Storyboard="{StaticResource Pulse}" />
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Ship -->
                    <DataGridTemplateColumn Header="SHIP" Width="158" SortMemberPath="Tier">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ShipIcon}" Width="34" Height="20" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ClassShort}" Foreground="{Binding ShipClass, Converter={StaticResource ClassBrush}}"
                                               FontWeight="SemiBold" FontSize="11" Width="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TierText}" Style="{StaticResource Dim}" FontSize="11" Width="26"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ShipName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="BATTLES" Width="58" SortMemberPath="Battles">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BattlesText}" Style="{StaticResource Num}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="WR" Width="52" SortMemberPath="WinRate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WinRateText}" Style="{StaticResource Num}"
                                           Foreground="{Binding WinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="DMG" Width="58" SortMemberPath="AvgDamage">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AvgDamageText}" Style="{StaticResource Num}"
                                           Foreground="{Binding DamageRatio, Converter={StaticResource Rating}, ConverterParameter=ratio}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="XpColumn" Header="XP" Width="48" SortMemberPath="AvgXp">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AvgXpText}" Style="{StaticResource Num}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="PR" Width="46" SortMemberPath="Pr">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PrText}" Style="{StaticResource Num}" FontWeight="SemiBold"
                                           Foreground="{Binding Pr, Converter={StaticResource Rating}, ConverterParameter=pr}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SHIP WR" Width="86" SortMemberPath="ShipWinRate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ShipWinRateText}" Style="{StaticResource Num}"
                                               Foreground="{Binding ShipWinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                                    <TextBlock Text="{Binding ShipBattlesText, StringFormat=' ({0})'}" Style="{StaticResource Num}"
                                               Foreground="{StaticResource TextDim}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="RecentColumn" Header="7 DAYS" Width="80" SortMemberPath="RecentWinRate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RecentText}" Style="{StaticResource Num}"
                                           Foreground="{Binding RecentWinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
