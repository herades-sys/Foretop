<Window x:Class="Broadside.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Broadside.App.ViewModels"
        xmlns:views="clr-namespace:Broadside.App.Views"
        Title="Broadside" Width="1560" Height="880" MinWidth="980" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LiveBattleViewModel}">
            <views:LiveBattleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <Border Style="{StaticResource Card}" Margin="20" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="560">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,22">
                    <TextBlock Text="BROADSIDE" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="battle monitor" Style="{StaticResource Dim}" FontSize="11" />
                </StackPanel>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Content="Live Battle" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Live}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Player Profiles" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Profiles}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Battle History" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Statistics" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Statistics}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding CurrentContent}" Focusable="False" />

        <!-- Status bar -->
        <Border Grid.ColumnSpan="2" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GameDetected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource RateGreen}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ApiText}" Style="{StaticResource Dim}" FontSize="11" DockPanel.Dock="Right" />
                <TextBlock Text="{Binding WatcherText}" Style="{StaticResource Dim}" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
