<Application x:Class="Foretop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Foretop.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] is the colour palette, swapped by ThemeManager; [1] the styles that use it. -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RatingBrushConverter x:Key="Rating" />
            <local:ShipClassBrushConverter x:Key="ClassBrush" />
            <local:BoolToVisibilityConverter x:Key="BoolVis" />
            <local:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullVis" />
            <local:NullToVisibilityConverter x:Key="InvNullVis" Invert="True" />
            <local:LevelBrushConverter x:Key="LevelBrush" />

            <!-- A labelled statistic: value, explanation, and where the number comes from. -->
            <DataTemplate x:Key="StatCardTemplate">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                        Padding="12,10" Margin="0,0,10,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Origin}" Style="{StaticResource Dim}" FontSize="9.5" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2"
                                   Foreground="{Binding Accent, TargetNullValue={StaticResource Text}}" />
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
