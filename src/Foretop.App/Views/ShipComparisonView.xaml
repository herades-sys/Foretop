<UserControl x:Class="Foretop.App.Views.ShipComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <Grid Margin="22,18,22,12">
        <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="{Binding Compared.Count, Converter={x:Static views:ZeroToVisible.Instance}}">
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="No ships to compare yet. Tick up to four ships in the Ship Database and choose Compare ships, or use Add to comparison on a ship profile." />
        </Border>
        <DockPanel Visibility="{Binding Compared.Count, Converter={x:Static views:NonZeroToVisible.Instance}}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Ship Comparison" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dim}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
                       Text="Bars show each value against the largest in its row; the best value is highlighted. Values are for the configuration chosen on the ship profile, before upgrades and commander skills." />
            <Border Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Ship headers -->
                        <Grid Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Compared}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,14,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" ToolTip="Remove from the comparison"
                                                    Command="{Binding DataContext.RemoveComparedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Dim}" FontSize="12">
                                                    <Run Text="{Binding NationName, Mode=OneWay}" /> · <Run Text="{Binding Availability, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ComparisonRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Section header -->
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,12,16,4"
                                                Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
                                        </Border>
                                        <!-- Value row -->
                                        <Grid Margin="16,4" Visibility="{Binding IsHeader, Converter={StaticResource InvBoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding Label}" />
                                                    <TextBlock Text="lower is better" FontSize="10" Foreground="{DynamicResource TextFaint}"
                                                               Visibility="{Binding LowerIsBetter, Converter={StaticResource BoolVis}}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource Tag}" Margin="8,0,0,0" Visibility="{Binding Tag, Converter={StaticResource NullVis}}">
                                                    <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="{DynamicResource StatusAmber}" />
                                                </Border>
                                            </StackPanel>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{Binding Text}" x:Name="value" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                                            <Grid Height="3" Margin="0,3,0,0" HorizontalAlignment="Stretch" x:Name="track">
                                                                <Border Background="{DynamicResource Border2}" CornerRadius="1.5" />
                                                                <Border Background="{DynamicResource TextDim}" CornerRadius="1.5" HorizontalAlignment="Left" x:Name="bar"
                                                                        Width="{Binding Ratio, Converter={x:Static views:RatioToWidth.Instance}, ConverterParameter=140}" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                <Setter TargetName="value" Property="FontWeight" Value="SemiBold" />
                                                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Accent}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
