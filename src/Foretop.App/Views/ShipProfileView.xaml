<UserControl x:Class="Foretop.App.Views.ShipProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <UserControl.Resources>
        <!-- Label / value rows with an optional origin tag. -->
        <DataTemplate x:Key="FactRowTemplate">
            <DockPanel Margin="0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Style="{StaticResource Tag}" Margin="0,0,8,0" Visibility="{Binding Tag, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="{DynamicResource StatusAmber}" />
                    </Border>
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextAlignment="Right" />
                </StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="KeyFigure">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" FontSize="12" />
                    <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,14,22,22">
            <Button Content="‹  All ships" Style="{StaticResource ListRowButton}" HorizontalAlignment="Left" Command="{Binding BackToListCommand}"
                    Foreground="{DynamicResource TextDim}" Margin="-8,0,0,8" />

            <!-- Header -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="300" Height="176" CornerRadius="6" Background="{DynamicResource Input}" Margin="0,0,20,0">
                        <Grid>
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="No artwork in the game files" Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Preview, Converter={StaticResource InvNullVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding ShipTags}" Style="{StaticResource Dim}" FontSize="12" />
                        <TextBlock Text="{Binding Current.DisplayName}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding Current.Description}" Style="{StaticResource Dim}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="WordEllipsis"
                                   ToolTip="{Binding Current.Description}" MaxWidth="820" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource SegmentedHost}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="config" Content="Stock"
                                                 IsChecked="{Binding UseTop, Converter={x:Static views:InvertBool.Instance}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="config" Content="Fully upgraded" IsChecked="{Binding UseTop}" />
                                </StackPanel>
                            </Border>
                            <Button Content="+ Add to comparison" Command="{Binding AddCurrentToComparisonCommand}" Margin="0,0,6,0" />
                            <Button Content="Equipment &amp; upgrades" Command="{Binding ShowEquipmentCommand}" Margin="0,0,6,0" />
                            <Button Content="Armour" Command="{Binding ShowArmourCommand}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Key figures -->
            <ItemsControl ItemsSource="{Binding KeyFigures}" ItemTemplate="{StaticResource KeyFigure}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding General.Title}" Style="{StaticResource H2}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding General.Rows}" ItemTemplate="{StaticResource FactRowTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Turret armour" Style="{StaticResource H2}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TurretArmour}" ItemTemplate="{StaticResource FactRowTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="More" Style="{StaticResource H2}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Summary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding MainArmament, Converter={StaticResource NullVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding MainArmament.Title}" Style="{StaticResource H2}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding MainArmament.Rows}" ItemTemplate="{StaticResource FactRowTemplate}" />
                            <TextBlock Text="{Binding MainArmament.Note}" Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Shells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Headline}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Tag}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FactRowTemplate}" />
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding Penetration.Count, Converter={x:Static views:NonZeroToVisible.Instance}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="PENETRATION BY RANGE" Style="{StaticResource SectionLabel}" />
                                                <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                                                    <TextBlock Text="calculated" FontSize="10" Foreground="{DynamicResource StatusAmber}" />
                                                </Border>
                                            </StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Range" Style="{StaticResource Dim}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="Belt penetration" Style="{StaticResource Dim}" FontSize="12" />
                                                <TextBlock Grid.Column="2" Text="Flight time" Style="{StaticResource Dim}" FontSize="12" />
                                                <TextBlock Grid.Column="3" Text="Angle of fall" Style="{StaticResource Dim}" FontSize="12" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Penetration}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Range}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Belt}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Time}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Angle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap">
                Characteristics, armour and shells are read from the installed game client. "calculated" values come from a ballistic model and
                "theoretical" ones assume every shell hits and deals full damage. Player results from the Wargaming API are kept apart, under Player Profiles.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
