<UserControl x:Class="Foretop.App.Views.LiveBattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views"
             xmlns:charts="clr-namespace:Foretop.App.Charts">
    <UserControl.Resources>
        <DataTemplate x:Key="CompareRow">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Origin}" Style="{StaticResource Dim}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FriendlyText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource Friendly}" FontWeight="SemiBold" Margin="0,0,10,0" />
                <charts:DualBar Grid.Column="2" Left="{Binding Friendly}" Right="{Binding Enemy}" Height="14" />
                <TextBlock Grid.Column="3" Text="{Binding EnemyText}" VerticalAlignment="Center" Foreground="{StaticResource Enemy}"
                           FontWeight="SemiBold" Margin="10,0,0,0" />
                <TextBlock Grid.Column="4" x:Name="diff" Text="{Binding DiffText}" Style="{StaticResource Dim}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FriendlyAhead}" Value="True">
                    <Setter TargetName="diff" Property="Foreground" Value="{StaticResource Friendly}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FriendlyAhead}" Value="False">
                    <Setter TargetName="diff" Property="Foreground" Value="{StaticResource Enemy}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="22,18,22,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0"
                        ToolTip="Fetch fresh statistics, ignoring the cache" IsEnabled="{Binding HasBattle}" />
                <Button Content="Open replay…" Command="{Binding OpenFileCommand}" Style="{StaticResource AccentButton}"
                        ToolTip="Show the teams of a .wowsreplay or tempArenaInfo.json file" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource RateGreen}" CornerRadius="3" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding IsInBattle, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Bg}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Notice -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8" CornerRadius="4" Background="{DynamicResource NoticeBg}" BorderBrush="{StaticResource RateYellow}"
                BorderThickness="1" Visibility="{Binding Notice, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>

        <!-- Filters + comparison -->
        <StackPanel Grid.Row="2" Margin="0,12,0,10" Visibility="{Binding HasBattle, Converter={StaticResource BoolVis}}">
        <!-- Statistics filter: which of each player's battles the statistics count -->
        <Border HorizontalAlignment="Left" Margin="0,0,0,10" Padding="12,6" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Panel}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatsFilterActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="STATISTICS FILTER" Style="{StaticResource Dim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding StatsFilterOptions}" SelectedItem="{Binding SelectedStatsFilter}" Width="130"
                          ToolTip="Count only each player's battles in ships of this tier and above (recalculated from their per-ship statistics)" />
                <Border Style="{StaticResource SegmentedHost}" Margin="10,0,10,0" IsEnabled="{Binding IsStatsFilterActive}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="statsview" Style="{StaticResource Segment}" Content="Overall" ToolTip="Show overall statistics"
                                     IsChecked="{Binding StatsViewMode, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Overall}" />
                        <RadioButton GroupName="statsview" Style="{StaticResource Segment}" Content="Filtered" ToolTip="Show filtered statistics"
                                     IsChecked="{Binding StatsViewMode, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Filtered}" />
                        <RadioButton GroupName="statsview" Style="{StaticResource Segment}" Content="Both" ToolTip="Compare both: overall above, filtered below"
                                     IsChecked="{Binding StatsViewMode, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Both}" />
                    </StackPanel>
                </Border>
                <CheckBox Content="Remember" IsChecked="{Binding RememberStatsFilter}" VerticalAlignment="Center"
                          ToolTip="Keep this filter for the next start (otherwise Foretop starts with all tiers)" />
                <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="9" Background="{DynamicResource AccentButtonBg}" VerticalAlignment="Center"
                        Visibility="{Binding IsStatsFilterActive, Converter={StaticResource BoolVis}}" ToolTip="{Binding TableBadgeTip}">
                    <TextBlock Text="{Binding SelectedStatsFilter.Label}" Foreground="{DynamicResource AccentButtonFg}" FontSize="11.5" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentedHost}" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="viewmode" Style="{StaticResource Segment}" Content="Teams"
                                     IsChecked="{Binding ShowComparison, Converter={x:Static views:InvertBool.Instance}}" />
                        <RadioButton GroupName="viewmode" Style="{StaticResource Segment}" Content="Comparison" IsChecked="{Binding ShowComparison}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Sort" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" Width="150" />
                <TextBlock Text="Ship tier" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,6,0" />
                <ComboBox ItemsSource="{Binding TierOptions}" SelectedItem="{Binding SelectedTier}" Width="100" MinWidth="90" />
                <TextBlock Text="Class" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,4,0" />
                <ToggleButton Style="{StaticResource Chip}" Content="DD" IsChecked="{Binding ShowDD}" />
                <ToggleButton Style="{StaticResource Chip}" Content="CA" IsChecked="{Binding ShowCA}" />
                <ToggleButton Style="{StaticResource Chip}" Content="BB" IsChecked="{Binding ShowBB}" />
                <ToggleButton Style="{StaticResource Chip}" Content="CV" IsChecked="{Binding ShowCV}" />
                <ToggleButton Style="{StaticResource Chip}" Content="SS" IsChecked="{Binding ShowSS}" />
            </StackPanel>
            <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                <views:StrengthBar Share="{Binding FriendlyShare}" Height="6" />
                <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        </StackPanel>

        <!-- Teams -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasBattle}" Value="True" />
                                <Condition Binding="{Binding ShowComparison}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:TeamTable Grid.Column="0" Header="FRIENDLY TEAM" Accent="{StaticResource Friendly}"
                             Rows="{Binding FriendlyView}" Summary="{Binding FriendlySummary}" Compact="{Binding CompactMode}"
                             ShowRecent="{Binding HasRecentData}" Badge="{Binding TableBadge}" BadgeTip="{Binding TableBadgeTip}"
                             TwoLine="{Binding ShowBothLines}" />
            <views:TeamTable Grid.Column="2" Header="ENEMY TEAM" Accent="{StaticResource Enemy}"
                             Rows="{Binding EnemyView}" Summary="{Binding EnemySummary}" Compact="{Binding CompactMode}"
                             ShowRecent="{Binding HasRecentData}" Badge="{Binding TableBadge}" BadgeTip="{Binding TableBadgeTip}"
                             TwoLine="{Binding ShowBothLines}" />
        </Grid>

        <!-- Team comparison -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasBattle}" Value="True" />
                                <Condition Binding="{Binding ShowComparison}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="FRIENDLY" Foreground="{StaticResource Friendly}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <TextBlock Text="ENEMY" Foreground="{StaticResource Enemy}" FontWeight="SemiBold" DockPanel.Dock="Right" />
                            <TextBlock Text="Team averages" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ComparisonRows}" ItemTemplate="{StaticResource CompareRow}" />
                        <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0">
                            Averages count only players with public statistics. "official" = raw Wargaming values, "derived" = arithmetic on them,
                            "third-party" = based on wows-numbers expected values. The difference column is friendly minus enemy.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Team composition" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding CompositionRows}" ItemTemplate="{StaticResource CompareRow}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Strength estimate" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <views:StrengthBar Share="{Binding FriendlyShare}" Height="10" />
                        <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                            Share of the two teams' combined average Personal Rating. It summarises past performance only; divisions,
                            map, ships and luck decide real battles, so it is not a prediction of the result.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640" Margin="0,16,0,0"
                Visibility="{Binding HasBattle, Converter={StaticResource InvBoolVis}}">
            <StackPanel>
                <TextBlock Text="How battle detection works" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20">
                    When a battle loads, World of Warships writes <Run Foreground="{StaticResource Text}">replays\tempArenaInfo.json</Run>
                    with every player's name and ship. Foretop reads that file — nothing in the game is changed or injected — and looks
                    the players up through the official Wargaming API.
                </TextBlock>
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20">
                    Needed: replays enabled in the game settings (the default), the game folder (found automatically or set in Settings),
                    and a free Wargaming application ID.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding ProgressText}" Style="{StaticResource Dim}" FontSize="11" Margin="2,8,0,0" />
    </Grid>
</UserControl>
