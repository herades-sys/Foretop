<UserControl x:Class="Foretop.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <UserControl.Resources>
        <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <DataTemplate x:Key="StatusCard">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="16,6,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ResultBlock">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Text}" />
                </DockPanel>
                <UniformGrid Columns="6" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Battles}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Num}" />
                        <TextBlock Text="{Binding Record}" Style="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding WinRateText}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Num}"
                                   Foreground="{Binding WinRate, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                        <TextBlock Text="Win rate" Style="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding AvgDamage}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Num}" />
                        <TextBlock Style="{StaticResource Dim}" FontSize="11">Avg damage · <Run Text="{Binding TotalDamage, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding AvgXp}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Num}" />
                        <TextBlock Text="Avg XP" Style="{StaticResource Dim}" FontSize="11" ToolTip="XP as the API counts it: with Premium Account, flags and bonuses" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding AvgFrags}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Num}" />
                        <TextBlock Text="Avg frags" Style="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Survival}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Num}" />
                        <TextBlock Text="Survived" Style="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding Pending}" Style="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" FontStyle="Italic"
                           Visibility="{Binding Pending, Converter={StaticResource NullVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">
            <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource Dim}" Margin="0,2,0,16" />

            <!-- Status -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="GAME CLIENT" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <Button DockPanel.Dock="Right" Content="Run check" VerticalAlignment="Top"
                                Command="{Binding GoCommand}" CommandParameter="{x:Static views:PageRef.Settings}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding ClientLevel, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Text="{Binding ClientTitle}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="{Binding ClientDetail}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="16,6,12,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="WARGAMING API" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <Button DockPanel.Dock="Right" Content="Settings" VerticalAlignment="Top"
                                Command="{Binding GoCommand}" CommandParameter="{x:Static views:PageRef.Settings}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding ApiLevel, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Text="{Binding ApiTitle}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="{Binding ApiDetail}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="16,6,12,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Your results: session, today, recent battles -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding HasResults, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Bottom"
                                   Text="From your account totals before and after each battle · Random, Ranked and Co-op" />
                        <TextBlock Text="YOUR RESULTS" Style="{StaticResource SectionLabel}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding SessionResults}" ContentTemplate="{StaticResource ResultBlock}" />
                        <ContentControl Grid.Column="2" Content="{Binding TodayResults}" ContentTemplate="{StaticResource ResultBlock}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding OwnBattles}" Margin="-16,14,-16,-16" MouseDoubleClick="OnOwnBattleDoubleClick" x:Name="Own">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding When}" Width="64" />
                            <DataGridTextColumn Header="BATTLE" Binding="{Binding Type}" Width="120" />
                            <DataGridTextColumn Header="MAP" Binding="{Binding Map}" Width="*" />
                            <DataGridTextColumn Header="SHIP" Binding="{Binding Ship}" Width="150" />
                            <DataGridTemplateColumn Header="RESULT" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Fill="{Binding OutcomeLevel, Converter={StaticResource LevelBrush}}" />
                                            <TextBlock Text="{Binding Outcome}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DAMAGE" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Damage}" Style="{StaticResource Num}" HorizontalAlignment="Right" Margin="0,0,10,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="XP" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Xp}" Style="{StaticResource Num}" HorizontalAlignment="Right" Margin="0,0,10,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FRAGS" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Frags}" Style="{StaticResource Num}" HorizontalAlignment="Right" Margin="0,0,10,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SURVIVED" Binding="{Binding Survived}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Last battle -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding HasHistory, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LAST BATTLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Open" Style="{StaticResource AccentButton}" Command="{Binding OpenBattleCommand}" Margin="0,0,6,0" />
                        <Button Content="Battle History" Command="{Binding GoCommand}" CommandParameter="{x:Static views:PageRef.History}" />
                    </StackPanel>
                    <StackPanel DataContext="{Binding LastBattle}">
                        <TextBlock FontSize="16" FontWeight="SemiBold">
                            <Run Text="{Binding Type, Mode=OneWay}" /> · <Run Text="{Binding Map, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,10">
                            <Run Text="{Binding WhenText, Mode=OneWay}" /> · your ship <Run Text="{Binding OwnShip, Mode=OneWay}" /> · <Run Text="{Binding Source, Mode=OneWay}" />
                        </TextBlock>
                        <Grid MaxWidth="900" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="FRIENDLY" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Friendly}" />
                            <TextBlock Grid.Column="2" Text="ENEMY" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Enemy}" />
                            <TextBlock Grid.Row="1" Text="Average win rate" Style="{StaticResource Dim}" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FriendlyWrText}" Style="{StaticResource Num}" Margin="0,4"
                                       Foreground="{Binding FriendlyWr, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding EnemyWrText}" Style="{StaticResource Num}" Margin="0,4"
                                       Foreground="{Binding EnemyWr, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                            <TextBlock Grid.Row="2" Text="Average PR" Style="{StaticResource Dim}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FriendlyPrText}" Style="{StaticResource Num}"
                                       Foreground="{Binding FriendlyPr, Converter={StaticResource Rating}, ConverterParameter=pr}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding EnemyPrText}" Style="{StaticResource Num}"
                                       Foreground="{Binding EnemyPr, Converter={StaticResource Rating}, ConverterParameter=pr}" />
                            <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" Margin="16,4,0,0" MinWidth="320">
                                <views:StrengthBar Share="{Binding Share}" Height="6" />
                                <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0">
                                    Strength estimate <Run Text="{Binding ShareText, Mode=OneWay}" /> friendly — past stats, not a prediction
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Visibility="{Binding HasHistory, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="RECENT BATTLES" Style="{StaticResource SectionLabel}" Margin="16,14,16,8" />
                        <DataGrid ItemsSource="{Binding RecentBattles}" MouseDoubleClick="OnBattleDoubleClick" x:Name="Recent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding WhenText}" Width="130" />
                                <DataGridTextColumn Header="BATTLE" Binding="{Binding Type}" Width="120" />
                                <DataGridTextColumn Header="MAP" Binding="{Binding Map}" Width="*" />
                                <DataGridTextColumn Header="YOUR SHIP" Binding="{Binding OwnShip}" Width="120" />
                                <DataGridTextColumn Header="STRENGTH" Binding="{Binding ShareText}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PLAYERS YOU MEET MOST" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="Nobody seen twice yet." Style="{StaticResource Dim}">
                            <TextBlock.Visibility>
                                <Binding Path="FrequentPlayers.Count" Converter="{x:Static views:ZeroToVisible.Instance}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding FrequentPlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ListRowButton}"
                                            Command="{Binding DataContext.OpenPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" FontSize="12">
                                                <Run Text="{Binding Times, Mode=OneWay}" />× · <Run Text="{Binding With, Mode=OneWay}" /> with, <Run Text="{Binding Against, Mode=OneWay}" /> against
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasHistory, Converter={StaticResource InvBoolVis}}" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Getting started" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0">
                        Start World of Warships and enter a battle: Foretop opens Live Battle on its own. Settings → Run check tells you if
                        anything is missing (game folder, replays, application ID).
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
