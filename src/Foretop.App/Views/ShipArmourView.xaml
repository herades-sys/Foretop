<UserControl x:Class="Foretop.App.Views.ShipArmourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <UserControl.Resources>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,14,22,12">
        <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="{Binding Current, Converter={StaticResource InvNullVis}}">
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="Open a ship in the Ship Database to see its armour. The armour model and plate thicknesses are read from the game client." />
        </Border>

        <DockPanel Visibility="{Binding Current, Converter={StaticResource NullVis}}">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Open ship profile" Command="{Binding ShowProfileSectionCommand}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Text="{Binding ShipTags}" />
                    <TextBlock Style="{StaticResource H1}" Text="{Binding Current.DisplayName}" />
                    <TextBlock Style="{StaticResource Dim}" Text="{Binding ArmourTitle}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Toolbar -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Thickness" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Armour1}" />
                    <TextBlock Text="under 20" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,10,0" />
                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Armour2}" />
                    <TextBlock Text="20–49" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,10,0" />
                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Armour3}" />
                    <TextBlock Text="50–149" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,10,0" />
                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Armour4}" />
                    <TextBlock Text="150–299" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,10,0" />
                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Armour5}" />
                    <TextBlock Text="300 mm and more" Style="{StaticResource Dim}" FontSize="12" />
                </StackPanel>
                <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding ArmourViews}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Segment}" GroupName="armourView" Content="{Binding}"
                                             Command="{Binding DataContext.SetArmourViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{x:Static views:AllEqual.Instance}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.ArmourView" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- Layers -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="LAYERS · MM" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Zones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsVisible}" Margin="0,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding Range}" Style="{StaticResource Dim}" FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Show all" Command="{Binding ShowAllZonesCommand}" Margin="0,0,6,0" />
                            <Button Content="Citadel only" Command="{Binding CitadelOnlyCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Hull armour only. Turret armour is listed on the ship profile." />
                    </StackPanel>
                </Border>

                <!-- Model -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
                    <Grid>
                        <TextBlock Text="Reading the armour model…" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ArmourMeshLoading, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding ArmourMeshMessage}" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                        <Grid Visibility="{Binding ShowTwoViews, Converter={StaticResource BoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PROFILE · STARBOARD SIDE" Style="{StaticResource SectionLabel}" Margin="10,6,0,0" />
                            <views:ArmourCanvas Grid.Row="1" View="Side" Mesh="{Binding ArmourMesh}" Plates="{Binding PlateMap}"
                                                HiddenZones="{Binding HiddenZones}" SelectedKey="{Binding SelectedPlateKey}" />
                            <TextBlock Grid.Row="2" Text="PLAN · FROM ABOVE" Style="{StaticResource SectionLabel}" Margin="10,6,0,0" />
                            <views:ArmourCanvas Grid.Row="3" View="Top" Mesh="{Binding ArmourMesh}" Plates="{Binding PlateMap}"
                                                HiddenZones="{Binding HiddenZones}" SelectedKey="{Binding SelectedPlateKey}" />
                        </Grid>
                        <views:ArmourCanvas View="{Binding SingleView}" Mesh="{Binding ArmourMesh}" Plates="{Binding PlateMap}"
                                            HiddenZones="{Binding HiddenZones}" SelectedKey="{Binding SelectedPlateKey}"
                                            Visibility="{Binding ShowTwoViews, Converter={StaticResource InvBoolVis}}" />
                    </Grid>
                </Border>

                <!-- Plate card and table -->
                <DockPanel Grid.Column="4">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ARMOUR SECTION" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Click a plate in the model to see it here." Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedPlateKey, Converter={StaticResource InvNullVis}}" />
                            <StackPanel Visibility="{Binding SelectedPlateKey, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SelectedPlateTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SelectedPlate}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ARMOUR TABLE" Style="{StaticResource SectionLabel}" Margin="12,12,12,4" />
                            <DataGrid ItemsSource="{Binding ArmourRows}" RowHeight="26" HeadersVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="26">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Swatch}" Background="{Binding Swatch}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Plate, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Zone, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="11" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Thickness}" FontWeight="SemiBold" Margin="0,0,8,0" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
