<UserControl x:Class="Foretop.App.Views.ShipIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <UserControl.Resources>
        <Style x:Key="SectionPanel" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section bar -->
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,8" MinHeight="52">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SourceText}" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" />
                <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="ships" Content="Ship Database"
                                     IsChecked="{Binding Section, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Database}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ships" Content="Armour Viewer"
                                     IsChecked="{Binding Section, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Armour}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ships" Content="Ship Statistics"
                                     IsChecked="{Binding Section, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Statistics}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ships" Content="Ship Comparison"
                                     IsChecked="{Binding Section, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Comparison}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ships" Content="Equipment &amp; Upgrades"
                                     IsChecked="{Binding Section, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Equipment}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- After a game update -->
        <Border Grid.Row="1" Margin="22,12,22,0" Padding="12,8" CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource NoticeBg}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1" Visibility="{Binding Banner, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" />
        </Border>

        <!-- States (design 6) -->
        <Grid Grid.Row="2" Margin="22,18">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StateKind}" Value="Ready">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- Reading -->
            <Border Width="560" VerticalAlignment="Top" Padding="28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StateKind}" Value="Reading"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding StateKind}" Value="Idle"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Reading ship data from the game client" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,12" TextAlignment="Center" TextWrapping="Wrap">
                        <Run Text="{Binding ProgressText, Mode=OneWay}" />. This takes a few seconds and happens once per game update.
                    </TextBlock>
                    <Grid Width="300" Height="4">
                        <Border Background="{DynamicResource Border2}" CornerRadius="2" />
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Accent}" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- No game -->
            <Border Width="560" VerticalAlignment="Top" Padding="28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StateKind}" Value="NoGame"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource RowHover}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextDim}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="No game installation to read from" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,6" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center">
                        Ship Intelligence reads characteristics and armour models straight from your installed World of Warships client.
                        No installation was found.
                    </TextBlock>
                    <Button Content="Choose the game folder" Style="{StaticResource AccentButton}" Command="{Binding ChooseGameFolderCommand}"
                            HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <!-- Failed -->
            <Border Width="560" VerticalAlignment="Top" Padding="28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StateKind}" Value="Failed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource StatusAmber}" StrokeThickness="1.7" Width="22" Height="22"
                          Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Text="The game files could not be read" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,6" />
                    <TextBlock Text="{Binding Failure}" Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Try again" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sections -->
        <Grid Grid.Row="2" Visibility="{Binding StateKind, Converter={x:Static views:EqualsToVisible.Instance}, ConverterParameter=Ready}">
            <views:ShipDatabaseView Visibility="{Binding Section, Converter={x:Static views:EqualsToVisible.Instance}, ConverterParameter=Database}" />
            <views:ShipArmourView Visibility="{Binding Section, Converter={x:Static views:EqualsToVisible.Instance}, ConverterParameter=Armour}" />
            <views:ShipStatisticsView Visibility="{Binding Section, Converter={x:Static views:EqualsToVisible.Instance}, ConverterParameter=Statistics}" />
            <views:ShipComparisonView Visibility="{Binding Section, Converter={x:Static views:EqualsToVisible.Instance}, ConverterParameter=Comparison}" />
            <views:ShipEquipmentView Visibility="{Binding Section, Converter={x:Static views:EqualsToVisible.Instance}, ConverterParameter=Equipment}" />

            <!-- Test ship: covers the profile, armour and equipment (the comparison does not accept test ships) -->
            <Border Background="{DynamicResource Bg}" Visibility="{Binding ShowTestShipNotice, Converter={StaticResource BoolVis}}">
                <Border Width="580" VerticalAlignment="Top" Margin="0,40,0,0" Padding="28" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TEST SHIP" Foreground="{DynamicResource StatusAmber}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Current.DisplayName}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,4,0,10" />
                        <TextBlock Text="{Binding TestShipNotice}" Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="Back to the ship list" Command="{Binding LeaveTestShipCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
