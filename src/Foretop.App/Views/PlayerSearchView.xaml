<UserControl x:Class="Foretop.App.Views.PlayerSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="PlayerChip">
            <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Margin="0,0,8,8" HorizontalContentAlignment="Left" Padding="12,0" MinWidth="170">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Player Search" Style="{StaticResource H1}" />
            <TextBlock Text="Find any player on the selected server and open their profile." Style="{StaticResource Dim}" Margin="0,2,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open profile" Style="{StaticResource AccentButton}" Command="{Binding OpenTypedCommand}" Margin="8,0,0,0" />
                        <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="14" MinHeight="34">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding OpenTypedCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" />
                        <TextBlock Text="  · searching…" Style="{StaticResource Dim}" Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource PlayerChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FROM YOUR RECENT BATTLES" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                    <TextBlock Text="No battles recorded yet." Style="{StaticResource Dim}">
                        <TextBlock.Visibility>
                            <Binding Path="RecentPlayers.Count" Converter="{x:Static views:ZeroToVisible.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding RecentPlayers}" ItemTemplate="{StaticResource PlayerChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
