<UserControl x:Class="Foretop.App.Views.TeamTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Number columns: header text over the right-aligned values -->
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
        </Storyboard>
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Open profile" Click="OnOpenProfile" FontWeight="SemiBold" />
            <MenuItem Header="Open official profile" Click="OnOpenOfficial" />
            <MenuItem Header="Open on wows-numbers.com" Click="OnOpenNumbers" />
            <MenuItem Header="Open on WoWS Karma" Click="OnOpenKarma" />
            <Separator />
            <MenuItem Header="Copy player name" Click="OnCopyName" />
        </ContextMenu>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}">
        <DockPanel>
            <!-- Team header -->
            <Border DockPanel.Dock="Top" BorderBrush="{Binding Accent, ElementName=Root}" BorderThickness="0,3,0,0" CornerRadius="6,6,0,0"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Header, ElementName=Root}" Style="{StaticResource H2}"
                               Foreground="{Binding Accent, ElementName=Root}" VerticalAlignment="Center" />
                    <Border DockPanel.Dock="Left" Margin="10,0,0,0" Padding="7,1" CornerRadius="{DynamicResource RadiusChip}" VerticalAlignment="Center"
                            BorderBrush="{Binding Accent, ElementName=Root}" BorderThickness="1" ToolTip="{Binding BadgeTip, ElementName=Root}"
                            Visibility="{Binding Badge, ElementName=Root, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Badge, ElementName=Root}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding Accent, ElementName=Root}" />
                    </Border>
                    <TextBlock x:Name="HiddenText" DockPanel.Dock="Right" Style="{StaticResource Dim}" FontSize="11" FontStyle="Italic"
                               Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                               ToolTip="Not enough width for every column. Widen the window to show them; the values are also in each row's tooltip and the player's profile." />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Dim}" FontSize="11.5" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 12 rows: no row virtualisation, so the column fitter sees every name -->
            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows, ElementName=Root}" MouseDoubleClick="OnRowDoubleClick"
                      EnableRowVirtualization="False" LoadingRow="OnLoadingRow" UnloadingRow="OnUnloadingRow"
                      ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Player -->
                    <DataGridTemplateColumn Header="PLAYER" Width="*" MinWidth="110" SortMemberPath="Name" views:ColumnFit.Flex="1">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ClanTag}" Style="{StaticResource Dim}" Margin="0,0,4,0"
                                               Visibility="{Binding ClanTag, Converter={StaticResource NullVis}}" />
                                    <TextBlock x:Name="state" DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource Dim}" FontSize="11"
                                               FontStyle="Italic" Margin="6,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="pulse" Storyboard="{StaticResource Pulse}" />
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Ship -->
                    <DataGridTemplateColumn Header="SHIP" Width="Auto" MinWidth="130" SortMemberPath="Tier" views:ColumnFit.Flex="1">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Image DockPanel.Dock="Left" Source="{Binding ShipIcon}" Width="34" Height="20" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,6,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ClassShort}" Foreground="{Binding ShipClass, Converter={StaticResource ClassBrush}}"
                                               FontWeight="SemiBold" FontSize="11" Width="20" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TierText}" Style="{StaticResource Dim}" FontSize="11" Width="26"
                                               VerticalAlignment="Center" />
                                    <!-- A ship in testing: marked before the name, where it cannot be cut off -->
                                    <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource StatusAmber}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="3,0" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Ship in testing: no ship statistics are shown, only the player's account"
                                            Visibility="{Binding IsTestShip, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="TEST" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusAmber}" />
                                    </Border>
                                    <TextBlock Text="{Binding ShipNameShown}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="BATTLES" Width="Auto" HeaderStyle="{StaticResource NumHeader}" SortMemberPath="Battles">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
<StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BattlesText}" Style="{StaticResource Num}" />
                                    <TextBlock Text="{Binding BattlesText2}" Style="{StaticResource Num}" FontSize="10.5" Foreground="{StaticResource TextDim}"
                                               Visibility="{Binding ShowSecond, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="WR" Width="Auto" HeaderStyle="{StaticResource NumHeader}" SortMemberPath="WinRate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
<StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WinRateText}" Style="{StaticResource Num}"
                                               Foreground="{Binding WinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                                    <TextBlock Text="{Binding WinRateText2}" Style="{StaticResource Num}" FontSize="10.5" Foreground="{Binding WinRateRated2, Converter={StaticResource Rating}, ConverterParameter=wr}"
                                               Visibility="{Binding ShowSecond, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="DMG" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="2" SortMemberPath="AvgDamage">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
<StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvgDamageText}" Style="{StaticResource Num}"
                                               Foreground="{Binding DamageRatio, Converter={StaticResource Rating}, ConverterParameter=ratio}" />
                                    <TextBlock Text="{Binding AvgDamageText2}" Style="{StaticResource Num}" FontSize="10.5" Foreground="{Binding DamageRatio2, Converter={StaticResource Rating}, ConverterParameter=ratio}"
                                               Visibility="{Binding ShowSecond, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="XpColumn" Header="XP" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="8" SortMemberPath="AvgXp">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
<StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvgXpText}" Style="{StaticResource Num}" />
                                    <TextBlock Text="{Binding AvgXpText2}" Style="{StaticResource Num}" FontSize="10.5" Foreground="{StaticResource TextDim}"
                                               Visibility="{Binding ShowSecond, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="PR" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="3" SortMemberPath="Pr">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
<StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrText}" Style="{StaticResource Num}" FontWeight="SemiBold"
                                               Foreground="{Binding Pr, Converter={StaticResource Rating}, ConverterParameter=pr}" />
                                    <TextBlock Text="{Binding PrText2}" Style="{StaticResource Num}" FontSize="10.5" Foreground="{Binding Pr2, Converter={StaticResource Rating}, ConverterParameter=pr}"
                                               Visibility="{Binding ShowSecond, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- In-game karma from WoWS Karma (third party); off in Settings: column disabled -->
                    <DataGridTemplateColumn x:Name="KarmaColumn" Header="KARMA" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="6" SortMemberPath="Karma">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="k" Text="{Binding KarmaText}" Style="{StaticResource Num}" VerticalAlignment="Center" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding KarmaNegative}" Value="True">
                                        <Setter TargetName="k" Property="Foreground" Value="{DynamicResource StatusRed}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Statistics in the ship of this battle (not affected by the tier filter) -->
                    <DataGridTemplateColumn Header="SHIP BTL" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="4" SortMemberPath="ShipBattles">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShipBattlesText}" Style="{StaticResource Num}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SHIP WR" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="7" SortMemberPath="ShipWinRate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShipWinRateText}" Style="{StaticResource Num}" VerticalAlignment="Center"
                                           Foreground="{Binding ShipWinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SHIP PR" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="5" SortMemberPath="ShipPr">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShipPrText}" Style="{StaticResource Num}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding ShipPrRated, Converter={StaticResource Rating}, ConverterParameter=pr}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="RecentColumn" Header="7 DAYS" Width="Auto" HeaderStyle="{StaticResource NumHeader}" views:ColumnFit.HidePriority="9" SortMemberPath="RecentWinRate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RecentText}" Style="{StaticResource Num}"
                                           Foreground="{Binding RecentWinRateRated, Converter={StaticResource Rating}, ConverterParameter=wr}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
