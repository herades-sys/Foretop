<UserControl x:Class="Foretop.App.Views.ShipStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views">
    <DockPanel Margin="22,18,22,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadStatsCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Ship Statistics" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Your own results per ship, from the Wargaming API. Ship names and classes come from the game client." />
                <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0" Text="{Binding StatsTitle}" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Loading your ship results…" Style="{StaticResource Dim}" Margin="0,0,0,10"
                   Visibility="{Binding StatsLoading, Converter={StaticResource BoolVis}}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12"
                Visibility="{Binding StatsMessage, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding StatsMessage}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
        </Border>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding StatsCards}" Margin="0,0,0,12"
                      Visibility="{Binding OwnShips.Count, Converter={x:Static views:NonZeroToVisible.Instance}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" FontSize="12" />
                            <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dim}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="Double-click a ship to open its profile. Random battles only. Personal rating uses the expected values Foretop downloads; under 10 battles it says little." />
        <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top"
                Visibility="{Binding OwnShips.Count, Converter={x:Static views:NonZeroToVisible.Instance}}">
            <DataGrid x:Name="Grid" ItemsSource="{Binding OwnShips}" RowHeight="28" MouseDoubleClick="OnRowOpen">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="SHIP" SortMemberPath="Name" Width="*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="NATION" Binding="{Binding Nation}" Width="110" />
                    <DataGridTextColumn Header="CLASS" Binding="{Binding Class}" Width="110" />
                    <DataGridTextColumn Header="TIER" Binding="{Binding TierText}" SortMemberPath="Tier" Width="50" />
                    <DataGridTextColumn Header="BATTLES" Binding="{Binding Battles, StringFormat=N0}" Width="76" />
                    <DataGridTextColumn Header="WIN RATE" Binding="{Binding WinRateText}" SortMemberPath="WinRate" Width="80" />
                    <DataGridTextColumn Header="AVG DAMAGE" Binding="{Binding AvgDamageText}" SortMemberPath="AvgDamage" Width="96" />
                    <DataGridTextColumn Header="AVG XP" Binding="{Binding AvgXpText}" SortMemberPath="AvgXp" Width="72" />
                    <DataGridTextColumn Header="AVG FRAGS" Binding="{Binding AvgFragsText}" SortMemberPath="AvgFrags" Width="82" />
                    <DataGridTextColumn Header="SURVIVED" Binding="{Binding SurvivalText}" SortMemberPath="Survival" Width="80" />
                    <DataGridTextColumn Header="PR" Binding="{Binding PrText}" SortMemberPath="Pr" Width="64" />
                    <DataGridTextColumn Header="LAST BATTLE" Binding="{Binding LastBattleText}" SortMemberPath="LastBattle" Width="96" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
