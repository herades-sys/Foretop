<UserControl x:Class="Foretop.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,16,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,14" />

            <!-- API -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Wargaming API" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Server region" Style="{StaticResource Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RegionOptions}" SelectedValuePath="Value" SelectedValue="{Binding Region}" Width="160"
                                  HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Text="Application ID" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6" Orientation="Horizontal"
                                    Visibility="{Binding IsEditingApplicationId, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="Saved · encrypted for your Windows account" VerticalAlignment="Center" />
                            <Button Content="Test" Command="{Binding TestApplicationIdCommand}" Margin="12,0,0,0" />
                            <Button Content="Change" Command="{Binding EditApplicationIdCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6"
                                   Visibility="{Binding IsEditingApplicationId, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestApplicationIdCommand}" Margin="6,0,0,0" />
                            <ToggleButton x:Name="ShowId" DockPanel.Dock="Right" Content="Show" Style="{StaticResource Chip}" Margin="6,0,0,0"
                                          VerticalAlignment="Center" ToolTip="Show or hide the application ID" />
                            <Grid>
                                <PasswordBox x:Name="IdBox" FontFamily="{StaticResource NumFont}" PasswordChanged="OnIdChanged"
                                             Visibility="{Binding IsChecked, ElementName=ShowId, Converter={StaticResource InvBoolVis}}" />
                                <TextBox Text="{Binding ApplicationId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource NumFont}"
                                         Visibility="{Binding IsChecked, ElementName=ShowId, Converter={StaticResource BoolVis}}"
                                         LostFocus="OnIdTextLostFocus" />
                            </Grid>
                        </DockPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{Binding TestResult}" Style="{StaticResource Hint}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Visibility="{Binding IsEditingApplicationId, Converter={StaticResource BoolVis}}">
                                Free: sign in at developers.wargaming.net, create an application of type “Mobile / Standalone”, paste its ID here.
                                It is stored encrypted for your Windows account.
                                <Hyperlink Command="{Binding OpenDeveloperPortalCommand}" Foreground="{StaticResource Accent}">Open the developer portal</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Requests per second" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                            <Slider Minimum="1" Maximum="10" Width="200" Value="{Binding ApiRatePerSecond}" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ApiRatePerSecond}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="  (Wargaming allows about 10)" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Game -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Game" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Game folder" Style="{StaticResource Label}" />
                        <DockPanel Grid.Column="1" Margin="0,6">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseGameRootCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding GameRoot, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="{Binding DetectedRoot, StringFormat='Leave empty to detect automatically. Detected now: {0}'}" />
                        <TextBlock Grid.Row="2" Text="Your account" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="Your in-game name. Filled in from the first battle Foretop sees; used for Ship Statistics and the sidebar." />
                    </Grid>
                    <CheckBox Content="Detect battles automatically" IsChecked="{Binding AutoDetectBattles}" />
                    <CheckBox Content="Switch to Live Battle when a battle starts" IsChecked="{Binding SwitchToLiveOnBattle}" />
                    <CheckBox Content="Show bots in co-op and operations" IsChecked="{Binding ShowBots}" />
                </StackPanel>
            </Border>

            <!-- Interface -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Interface and startup" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Theme" Style="{StaticResource Dim}" VerticalAlignment="Center" Width="60" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="140" />
                        <TextBlock Text="System follows the Windows app theme" Style="{StaticResource Dim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Font" Style="{StaticResource Dim}" VerticalAlignment="Center" Width="60" />
                        <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding Font}" Width="240" MaxDropDownHeight="360"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontSize="13" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Any font installed on Windows; each is shown in its own style" Style="{StaticResource Dim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Text size" Style="{StaticResource Dim}" VerticalAlignment="Center" Width="60" />
                        <ComboBox ItemsSource="{Binding TextScaleOptions}" SelectedItem="{Binding TextScale}" Width="140" />
                        <TextBlock Text="Scales the whole interface, so tables and charts keep their proportions" Style="{StaticResource Dim}"
                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <CheckBox Content="Compact mode (fewer columns, tighter rows)" IsChecked="{Binding CompactMode}" />
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Content="Start minimised" IsChecked="{Binding StartMinimized}" />
                </StackPanel>
            </Border>

            <!-- Cache -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Cache" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Player statistics" Style="{StaticResource Label}" />
                        <TextBox Grid.Column="1" Text="{Binding PlayerCacheMinutes}" Margin="0,4" />
                        <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Label}" Margin="8,0" />
                        <TextBlock Grid.Row="1" Text="Clan tags" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClanCacheHours}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="hours" Style="{StaticResource Label}" Margin="8,0" />
                    </Grid>
                    <TextBlock Text="{Binding CacheInfo}" Style="{StaticResource Hint}" Margin="0,8,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mark cache stale" Command="{Binding InvalidateCacheCommand}" Margin="0,0,6,0" />
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Padding="24,6" />
                <TextBlock Text="{Binding SaveResult}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- Detection check -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Run check" Command="{Binding RunChecksCommand}" />
                        <StackPanel>
                            <TextBlock Text="Detection check" Style="{StaticResource H2}" />
                            <TextBlock Text="Why a battle is or is not picked up: game, folder, replays, battle file and API. Uses the values above, even unsaved."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Checking…" Style="{StaticResource Dim}" Visibility="{Binding IsChecking, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="sym" Text="{Binding Symbol}" FontWeight="Bold" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Ok">
                                        <Setter TargetName="sym" Property="Foreground" Value="{StaticResource RateGreen}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                        <Setter TargetName="sym" Property="Foreground" Value="{StaticResource RateYellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Problem">
                                        <Setter TargetName="sym" Property="Foreground" Value="{StaticResource RateRed}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                        Player statistics: Wargaming.net public API. Personal Rating expected values: wows-numbers.com.
                        Foretop reads the battle roster from the file the game writes for replays; it does not modify or inject anything.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}">
                        Foretop is not affiliated with or endorsed by Wargaming. World of Warships is a trademark of Wargaming.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}">
                        Copyright 2026 herades-sys. Licensed under the Apache License 2.0; LICENSE, NOTICE and THIRD-PARTY-NOTICES.txt are next to Foretop.exe.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,6,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
