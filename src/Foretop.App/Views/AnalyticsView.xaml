<UserControl x:Class="Foretop.App.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foretop.App.Views"
             xmlns:vm="clr-namespace:Foretop.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:PersonalAnalyticsViewModel}"><views:PersonalAnalyticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><views:StatisticsView /></DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left" Margin="22,14,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="analyticsTab" Style="{StaticResource Segment}" Content="My performance"
                             IsChecked="{Binding ShowRecorded, Converter={x:Static views:InvertBool.Instance}}" />
                <RadioButton GroupName="analyticsTab" Style="{StaticResource Segment}" Content="Recorded battles" IsChecked="{Binding ShowRecorded}" />
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding Current}" Focusable="False" />
    </DockPanel>
</UserControl>
