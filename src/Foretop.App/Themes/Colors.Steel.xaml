<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Foretop theme "Steel": generated from its design tokens (design canvas "Foretop design themes").
         Every key of Colors.Dark.xaml is here; keep them in step. -->
    <SolidColorBrush x:Key="Bg" Color="#0E1219" />
    <SolidColorBrush x:Key="Sidebar" Color="#141A23" />
    <SolidColorBrush x:Key="Input" Color="#121821" />
    <SolidColorBrush x:Key="Panel" Color="#1A212C" />
    <SolidColorBrush x:Key="Panel2" Color="#232E3D" />
    <SolidColorBrush x:Key="Selected" Color="#2A3F5C" />
    <SolidColorBrush x:Key="Border" Color="#2B3646" />
    <SolidColorBrush x:Key="Border2" Color="#3C4A5D" />
    <SolidColorBrush x:Key="RowHover" Color="#222C3A" />
    <SolidColorBrush x:Key="RowSelected" Color="#1F3553" />
    <SolidColorBrush x:Key="SelfRow" Color="#18332F" />
    <SolidColorBrush x:Key="AltRow" Color="#1E2632" />
    <SolidColorBrush x:Key="NavActive" Color="#335B9FE0" />
    <SolidColorBrush x:Key="Text" Color="#EDF1F6" />
    <SolidColorBrush x:Key="TextSecondary" Color="#CDD5DF" />
    <SolidColorBrush x:Key="TextDim" Color="#B3BDCA" />
    <SolidColorBrush x:Key="TextFaint" Color="#949FAF" />
    <SolidColorBrush x:Key="Accent" Color="#62A3E1" />
    <SolidColorBrush x:Key="AccentLight" Color="#8FC0F2" />
    <SolidColorBrush x:Key="AccentButtonBg" Color="#5B9FE0" />
    <SolidColorBrush x:Key="AccentButtonFg" Color="#08121E" />
    <SolidColorBrush x:Key="StatusGreen" Color="#4CC38A" />
    <SolidColorBrush x:Key="StatusAmber" Color="#E2B65E" />
    <SolidColorBrush x:Key="StatusRed" Color="#F17B74" />
    <SolidColorBrush x:Key="NoticeBg" Color="#2C2718" />
    <SolidColorBrush x:Key="Friendly" Color="#9CEBDF" />
    <SolidColorBrush x:Key="ChatOverlay" Color="#E0141A23" />
    <SolidColorBrush x:Key="Enemy" Color="#EE6F65" />
    <SolidColorBrush x:Key="RateRed" Color="#F17B74" />
    <SolidColorBrush x:Key="RateYellow" Color="#E2B65E" />
    <SolidColorBrush x:Key="RateGreen" Color="#4CC38A" />
    <SolidColorBrush x:Key="RatePurple" Color="#B98BFF" />
    <SolidColorBrush x:Key="ClassDD" Color="#8FC0F2" />
    <SolidColorBrush x:Key="ClassCA" Color="#A3D98F" />
    <SolidColorBrush x:Key="ClassBB" Color="#EFC06A" />
    <SolidColorBrush x:Key="ClassCV" Color="#CDA4F6" />
    <SolidColorBrush x:Key="ClassSS" Color="#72D9CD" />
    <SolidColorBrush x:Key="Armour1" Color="#9A7AD1" />
    <SolidColorBrush x:Key="Armour2" Color="#2FB3A3" />
    <SolidColorBrush x:Key="Armour3" Color="#8DC63F" />
    <SolidColorBrush x:Key="Armour4" Color="#F2B33D" />
    <SolidColorBrush x:Key="Armour5" Color="#E8604B" />
    <SolidColorBrush x:Key="ArmourNone" Color="#66727F" />

    <!-- Shape, type and density -->
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusSection">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusChip">12</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <FontFamily x:Key="ThemeFontUi">Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeFontHeading">Segoe UI Semibold</FontFamily>
    <sys:Double x:Key="RowHeight">28</sys:Double>
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
</ResourceDictionary>
