<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Foretop Light palette. Every key must exist in both colour files. -->
    <SolidColorBrush x:Key="Bg" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Sidebar" Color="#E9EDF2" />
    <SolidColorBrush x:Key="Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel2" Color="#EEF1F5" />
    <SolidColorBrush x:Key="Selected" Color="#DCE6F3" />
    <SolidColorBrush x:Key="Border" Color="#D5DCE5" />
    <SolidColorBrush x:Key="Border2" Color="#C6CFDA" />
    <SolidColorBrush x:Key="RowHover" Color="#EEF3FA" />
    <SolidColorBrush x:Key="RowSelected" Color="#DCE6F3" />
    <SolidColorBrush x:Key="SelfRow" Color="#E3F3EC" />
    <SolidColorBrush x:Key="AltRow" Color="#F8FAFC" />
    <SolidColorBrush x:Key="NavActive" Color="#242F7FD0" />
    <SolidColorBrush x:Key="Text" Color="#18202B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#3A4656" />
    <SolidColorBrush x:Key="TextDim" Color="#5C6878" />
    <SolidColorBrush x:Key="TextFaint" Color="#8C97A5" />
    <SolidColorBrush x:Key="Accent" Color="#2F7FD0" />
    <SolidColorBrush x:Key="AccentLight" Color="#1F66B0" />
    <SolidColorBrush x:Key="AccentButtonBg" Color="#2F7FD0" />
    <SolidColorBrush x:Key="AccentButtonFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusGreen" Color="#24874F" />
    <SolidColorBrush x:Key="StatusAmber" Color="#A87410" />
    <SolidColorBrush x:Key="StatusRed" Color="#C63B35" />
    <SolidColorBrush x:Key="NoticeBg" Color="#FFF3D1" />
    <SolidColorBrush x:Key="Friendly" Color="#0F8276" />
    <SolidColorBrush x:Key="ChatOverlay" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="Enemy" Color="#C63B35" />
    <SolidColorBrush x:Key="RateRed" Color="#C63B35" />
    <SolidColorBrush x:Key="RateYellow" Color="#A87410" />
    <SolidColorBrush x:Key="RateGreen" Color="#24874F" />
    <SolidColorBrush x:Key="RatePurple" Color="#7238C9" />
    <SolidColorBrush x:Key="ClassDD" Color="#1A6FB5" />
    <SolidColorBrush x:Key="ClassCA" Color="#3A852B" />
    <SolidColorBrush x:Key="ClassBB" Color="#B8700E" />
    <SolidColorBrush x:Key="ClassCV" Color="#8E44C6" />
    <SolidColorBrush x:Key="ClassSS" Color="#11807A" />
    <!-- Armour thickness: distinct hues, thin to thick (no blue: that is the selection accent). -->
    <SolidColorBrush x:Key="Armour1" Color="#7350B0" />
    <SolidColorBrush x:Key="Armour2" Color="#16897C" />
    <SolidColorBrush x:Key="Armour3" Color="#5E9A20" />
    <SolidColorBrush x:Key="Armour4" Color="#C98310" />
    <SolidColorBrush x:Key="Armour5" Color="#C03822" />
    <SolidColorBrush x:Key="ArmourNone" Color="#B8C0CC" />

    <!-- Shape, type and density: themes may change these too (not only colours). -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusSection">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">5</CornerRadius>
    <CornerRadius x:Key="RadiusChip">12</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <FontFamily x:Key="ThemeFontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeFontHeading">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="RowHeight">28</sys:Double>
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
