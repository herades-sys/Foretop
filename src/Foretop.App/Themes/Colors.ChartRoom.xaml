    <SolidColorBrush x:Key="Sidebar" Color="#EAE2CD" />
    <SolidColorBrush x:Key="Input" Color="#FCF9F0" />
    <SolidColorBrush x:Key="Panel" Color="#FBF7EC" />
    <SolidColorBrush x:Key="Panel2" Color="#EEE6D0" />
