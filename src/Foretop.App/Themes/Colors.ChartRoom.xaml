    <SolidColorBrush x:Key="Armour5" Color="#C03822" />
    <SolidColorBrush x:Key="ArmourNone" Color="#A9A08A" />

    <!-- Shape, type and density -->
    <CornerRadius x:Key="RadiusCard">3</CornerRadius>
    <CornerRadius x:Key="RadiusSection">2</CornerRadius>
    <CornerRadius x:Key="RadiusControl">2</CornerRadius>
    <CornerRadius x:Key="RadiusChip">3</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">2</CornerRadius>
    <FontFamily x:Key="ThemeFontUi">Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeFontHeading">Georgia</FontFamily>
    <sys:Double x:Key="RowHeight">28</sys:Double>
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
