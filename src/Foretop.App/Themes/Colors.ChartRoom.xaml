    <SolidColorBrush x:Key="Border2" Color="#B9AB89" />
    <SolidColorBrush x:Key="RowHover" Color="#F2EAD3" />
    <SolidColorBrush x:Key="RowSelected" Color="#E9DCB6" />
    <SolidColorBrush x:Key="SelfRow" Color="#DCE7DA" />
    <SolidColorBrush x:Key="AltRow" Color="#F7F2E3" />
    <SolidColorBrush x:Key="NavActive" Color="#40B8862B" />
    <SolidColorBrush x:Key="Text" Color="#12213A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#2B3A54" />
    <SolidColorBrush x:Key="TextDim" Color="#3E4B60" />
