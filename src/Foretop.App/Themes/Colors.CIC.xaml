<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Foretop theme "Combat Information Center": generated from its design tokens (design canvas "Foretop design themes").
         Every key of Colors.Dark.xaml is here; keep them in step. -->
    <SolidColorBrush x:Key="Bg" Color="#050708" />
    <SolidColorBrush x:Key="Sidebar" Color="#0A0D10" />
    <SolidColorBrush x:Key="Input" Color="#0A0D10" />
    <SolidColorBrush x:Key="Panel" Color="#0D1115" />
    <SolidColorBrush x:Key="Panel2" Color="#1A2128" />
    <SolidColorBrush x:Key="Selected" Color="#0F3A46" />
    <SolidColorBrush x:Key="Border" Color="#27323B" />
    <SolidColorBrush x:Key="Border2" Color="#3D4B57" />
    <SolidColorBrush x:Key="RowHover" Color="#182027" />
    <SolidColorBrush x:Key="RowSelected" Color="#0C303B" />
    <SolidColorBrush x:Key="SelfRow" Color="#2B2408" />
    <SolidColorBrush x:Key="AltRow" Color="#11161B" />
    <SolidColorBrush x:Key="NavActive" Color="#3822D3EE" />
    <SolidColorBrush x:Key="Text" Color="#F3F7F9" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C8D1D9" />
    <SolidColorBrush x:Key="TextDim" Color="#A3AFBA" />
    <SolidColorBrush x:Key="TextFaint" Color="#8A97A3" />
    <SolidColorBrush x:Key="Accent" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentLight" Color="#8AEAF8" />
    <SolidColorBrush x:Key="AccentButtonBg" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentButtonFg" Color="#02161A" />
    <SolidColorBrush x:Key="StatusGreen" Color="#3DDC84" />
    <SolidColorBrush x:Key="StatusAmber" Color="#FFB627" />
    <SolidColorBrush x:Key="StatusRed" Color="#FF7466" />
    <SolidColorBrush x:Key="NoticeBg" Color="#2A2100" />
    <SolidColorBrush x:Key="Friendly" Color="#4C86F2" />
    <SolidColorBrush x:Key="ChatOverlay" Color="#E60A0D10" />
    <SolidColorBrush x:Key="Enemy" Color="#FFC060" />
    <SolidColorBrush x:Key="RateRed" Color="#FF7466" />
    <SolidColorBrush x:Key="RateYellow" Color="#FFD23F" />
    <SolidColorBrush x:Key="RateGreen" Color="#3DDC84" />
    <SolidColorBrush x:Key="RatePurple" Color="#C99BFF" />
    <SolidColorBrush x:Key="ClassDD" Color="#7CC4FF" />
    <SolidColorBrush x:Key="ClassCA" Color="#9BE38A" />
    <SolidColorBrush x:Key="ClassBB" Color="#FFC65C" />
    <SolidColorBrush x:Key="ClassCV" Color="#D2A6FF" />
    <SolidColorBrush x:Key="ClassSS" Color="#5FE0D0" />
    <SolidColorBrush x:Key="Armour1" Color="#9A7AD1" />
    <SolidColorBrush x:Key="Armour2" Color="#2FB3A3" />
    <SolidColorBrush x:Key="Armour3" Color="#8DC63F" />
    <SolidColorBrush x:Key="Armour4" Color="#F2B33D" />
    <SolidColorBrush x:Key="Armour5" Color="#E8604B" />
    <SolidColorBrush x:Key="ArmourNone" Color="#5F6B76" />

    <!-- Shape, type and density -->
    <CornerRadius x:Key="RadiusCard">2</CornerRadius>
    <CornerRadius x:Key="RadiusSection">0</CornerRadius>
    <CornerRadius x:Key="RadiusControl">0</CornerRadius>
    <CornerRadius x:Key="RadiusChip">0</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">0</CornerRadius>
    <FontFamily x:Key="ThemeFontUi">Bahnschrift</FontFamily>
    <FontFamily x:Key="ThemeFontHeading">Bahnschrift</FontFamily>
    <sys:Double x:Key="RowHeight">24</sys:Double>
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
</ResourceDictionary>
