<Window x:Class="Foretop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Foretop.App.ViewModels"
        xmlns:views="clr-namespace:Foretop.App.Views"
        Title="Foretop" Icon="/Assets/foretop.ico" Width="1560" Height="880" MinWidth="1080" MinHeight="600"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontSize="13"
        FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LiveBattleViewModel}"><views:LiveBattleView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><views:ProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><views:StatisticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayerSearchViewModel}"><views:PlayerSearchView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShipIntelligenceViewModel}"><views:ShipIntelligenceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReplaysViewModel}"><views:ReplaysView /></DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{x:Static views:ShellCommands.FocusSearch}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding GoForwardCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- Text size in Settings scales the whole interface -->
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Sidebar}" />
                    <Setter Property="Width" Value="216" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Width" Value="60" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="44" Margin="16,0">
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Accent}" CornerRadius="6" />
                        <Path Data="{StaticResource LogoMark}" Stroke="#0B1522" StrokeThickness="1.7" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                    </Grid>
                    <TextBlock Text="Foretop" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolVis}}" />
                </StackPanel>

                <!-- Account footer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="19,14"
                        Background="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock><Run Text="{Binding AccountName, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak /><Run Text="{Binding ClientText, Mode=OneWay}" /></TextBlock>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,11,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource StatusGreen}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            <TextBlock Text="{Binding ClientText}" Style="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Collapse / expand -->
                <Button DockPanel.Dock="Bottom" Command="{Binding ToggleSidebarCommand}" Margin="8,0,8,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavAction}">
                            <Setter Property="Content" Value="Collapse" />
                            <Setter Property="Tag" Value="{StaticResource IconSidebarCollapse}" />
                            <Setter Property="ToolTip" Value="Show icons only (Ctrl+B)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Tag" Value="{StaticResource IconSidebarExpand}" />
                                    <Setter Property="ToolTip" Value="Expand the sidebar (Ctrl+B)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="{StaticResource IconDashboard}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Dashboard}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Live Battle" Tag="{StaticResource IconLive}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Live}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Player Search" Tag="{StaticResource IconSearch}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=PlayerSearch}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Player Profiles" Tag="{StaticResource IconPlayers}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Profiles}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Ship Intelligence" Tag="{StaticResource IconShip}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Ships}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Battle History" Tag="{StaticResource IconHistory}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Replays" Tag="{StaticResource IconReplay}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Replays}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Analytics" Tag="{StaticResource IconAnalytics}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Analytics}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="{StaticResource IconSettings}" GroupName="nav"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Command="{Binding GoBackCommand}" ToolTip="Back (Alt+Left)">
                            <Path Data="{StaticResource IconBack}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding GoForwardCommand}" ToolTip="Forward (Alt+Right)" Margin="2,0,10,0">
                            <Path Data="{StaticResource IconForward}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="{Binding BreadcrumbParent}" Style="{StaticResource Dim}" FontWeight="Medium" VerticalAlignment="Center"
                                   Visibility="{Binding BreadcrumbParent, Converter={StaticResource NullVis}}" />
                        <Path Data="{StaticResource IconChevron}" Stroke="{DynamicResource TextFaint}" StrokeThickness="1.7" Width="9" Height="9"
                              Stretch="Uniform" Margin="10,0" VerticalAlignment="Center"
                              Visibility="{Binding BreadcrumbParent, Converter={StaticResource NullVis}}" />
                        <TextBlock Text="{Binding BreadcrumbTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="GlobalSearch" Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Search players or ships" MaxWidth="520"
                             Margin="16,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding Updates.TogglePanelCommand}" Margin="0,0,8,0" Cursor="Hand" ToolTip="A newer Foretop is available"
                                Visibility="{Binding Updates.ShowNotice, Converter={StaticResource BoolVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource AccentButtonBg}" CornerRadius="11" Padding="10,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12 4v11 M7 10l5 5l5 -5 M5 19h14" Stroke="{DynamicResource AccentButtonFg}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11"
                                                  Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Updates.NoticeText}" Foreground="{DynamicResource AccentButtonFg}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Style="{StaticResource Pill}" ToolTip="{Binding ApiStatusTooltip}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding ApiStatusLevel, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Text="{Binding ApiStatusText}" Style="{StaticResource Dim}" FontSize="12" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" ToolTip="Server region (change it in Settings)">
                            <TextBlock Text="{Binding RegionText}" Style="{StaticResource Dim}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" Focusable="False" />

            <!-- Update panel (opened from the top-bar notice) -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,14,0" Width="460" Padding="16,14"
                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding Updates.IsPanelOpen, Converter={StaticResource BoolVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Updates.Available.Title}" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Margin="0,2,0,8">
                        <Run Text="You have" /> <Run Text="{Binding VersionShort, Mode=OneWay}" /><Run Text=" · released " /><Run
                            Text="{Binding Updates.Available.PublishedAt, Mode=OneWay, StringFormat=d}" />
                    </TextBlock>
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Updates.NotesPreview}" TextWrapping="Wrap" FontSize="12" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding Updates.ProgressText}" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Updates.ProgressText, Converter={StaticResource NullVis}}" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Updates.IsInstalledCopy, Converter={StaticResource InvBoolVis}}"
                               Text="This is the portable version: download the new zip from the release page and replace Foretop.exe." />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{Binding Updates.InstallLabel}" Command="{Binding Updates.InstallCommand}" Style="{StaticResource AccentButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Release page" Command="{Binding Updates.OpenReleasePageCommand}" Margin="0,0,6,0" />
                        <Button Content="Skip this version" Command="{Binding Updates.SkipCommand}" Margin="0,0,6,0" />
                        <Button Content="Later" Command="{Binding Updates.LaterCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
