<Project>
  <!-- Shared metadata for every project. Bump Version here for a release. -->
  <PropertyGroup>
    <Version>1.7.0</Version>
    <Product>Foretop</Product>
    <Company>Foretop</Company>
    <Description>World of Warships battle monitor</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
</Project>
